DirectoryIndex index.html index.php

# Vynucení zabezpečeného spojení HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Navýšení limitů pro nahrávání velkých fotek a audia
php_value post_max_size 64M
php_value upload_max_filesize 64M
php_value memory_limit 256M
php_value max_execution_time 300

# =============================================================
# CACHE CONTROL – HTML a PHP se nikdy nekešují
# CSS, JS, obrázky se kešují (s verzováním přes ?v=...)
# =============================================================

# Metoda 1: mod_headers (pokud je dostupný)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Metoda 2: mod_expires (záloha pokud mod_headers není)
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML a PHP – vyprší okamžitě (1 sekunda od přístupu)
  ExpiresByType text/html "access plus 1 seconds"
  ExpiresByType application/x-httpd-php "access plus 1 seconds"
  # CSS a JS – vyprší za 1 rok (verzováno přes ?v=timestamp)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>