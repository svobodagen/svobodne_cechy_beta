DirectoryIndex index.html index.php

# Vynucení zabezpečeného spojení HTTPS (Active24 – za reverzním proxy)
RewriteEngine On
# Kontrola přes %{HTTPS} (přímé připojení)
RewriteCond %{HTTPS} off
# Kontrola přes X-Forwarded-Proto (za proxy/load balancerem)
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Upgrade všechny nebezpečné požadavky na HTTPS
Header always set Content-Security-Policy "upgrade-insecure-requests"

# Navýšení limitů pro nahrávání velkých fotek a audia
php_value post_max_size 64M
php_value upload_max_filesize 64M
php_value memory_limit 256M
php_value max_execution_time 300

# =============================================================
# CACHE CONTROL – HTML a PHP se nikdy nekešují
# CSS, JS, obrázky se kešují (s verzováním přes ?v=...)
# =============================================================

# Metoda 1: mod_headers (pokud je dostupný)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Obrázky v /uploads/ – kešovat a povolit přístup pro sociální sítě (OG image scrapers)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=2592000"
    Header set Access-Control-Allow-Origin "*"
    Header set X-Robots-Tag "all"
  </FilesMatch>
</IfModule>

# Metoda 2: mod_expires (záloha pokud mod_headers není)
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML a PHP – vyprší okamžitě (1 sekunda od přístupu)
  ExpiresByType text/html "access plus 1 seconds"
  ExpiresByType application/x-httpd-php "access plus 1 seconds"
  # CSS a JS – vyprší za 1 rok (verzováno přes ?v=timestamp)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>